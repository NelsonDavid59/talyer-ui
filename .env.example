# Copiar a .env.local y completar con los valores de la app SPA en Auth0.
VITE_AUTH0_DOMAIN=<tenant>.us.auth0.com
VITE_AUTH0_CLIENT_ID=<spa-client-id>
# Identifier de la API en Auth0 (debe coincidir con Auth0:Api:Audience en talyer-api)
VITE_AUTH0_AUDIENCE=talyer-api
VITE_AUTH0_CONNECTION=email

# Vacío en desarrollo: las llamadas van a /session y Vite las proxya a la API.
VITE_TALYER_API_URL=

# Solo para el proxy de Vite en dev (no se expone al bundle).
TALYER_API_PROXY_TARGET=http://localhost:5066
